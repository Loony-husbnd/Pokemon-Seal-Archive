{
  "name": "pokemon-seal-archive",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode holo",
    "dev:holo": "vite --mode holo",
    "dev:proelium": "vite --mode proelium",
    "build": "vite build --mode holo && vite build --mode proelium",
    "preview": "vite preview --mode holo",
    "battle:data": "node tools/build-battle-data.mjs",
    "battle:validate": "node tools/validate-battle-data.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "test:battle": "node --test packages/rembrandt/engine.test.mjs packages/rembrandt/ai.test.mjs",
    "sim:battle": "node tools/simulate-battles.mjs",
    "sim:ai": "node tools/simulate-ai.mjs"
  },
  "devDependencies": {
    "vite": "^6.2.3"
  }
}
